{
  "name": "arc-like-peek",
  "version": "0.1.0",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.63.0",
    "@types/bun": "latest",
    "@types/chrome": "^0.3.7",
    "typescript": "7.0.2"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "package": "bun scripts/package.ts",
    "release": "bun scripts/release.ts",
    "dev": "bun scripts/build.ts --watch",
    "typecheck": "bun --bun tsc",
    "lint": "bun --bun biome check .",
    "lint:fix": "bun --bun biome check --write .",
    "test": "bun test",
    "test:e2e": "bun run build && bun --bun playwright test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run test:e2e",
    "test:real-sites": "bun run build && bun --bun playwright test -c playwright.real-sites.config.ts"
  }
}
