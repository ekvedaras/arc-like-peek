{
  "manifest_version": 3,
  "name": "Arc-like Peek",
  "description": "Shift+click a link to peek at it in an overlay, like Arc's Peek.",
  "version": "0.0.1",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/peek-frame-script.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["peek-window/peek-window.html"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ],
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["<all_urls>"]
}
